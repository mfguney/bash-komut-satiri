[Unit]
Description=Sıcaklık sensörü izleme servisi
After=local-fs.target

[Service]
Type=simple
# Program ayarlarını /etc/default/sensor-izle dosyasından kendisi okur.
# Standart çıktı ve standart hata varsayılan olarak journal'a gider; ayrı günlük dosyası gerekmez.
ExecStart=/usr/bin/sensor-izle
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure

[Install]
WantedBy=multi-user.target
